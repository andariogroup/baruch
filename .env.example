# Public site origin without a trailing slash.
# Local: http://localhost:3000
# Production canonical (confirmed): https://www.baruchhostal.com
# Apex baruchhostal.com redirects to www. Never use localhost in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# External booking engine. Full http(s) URL. Empty = Reservar stays disabled.
NEXT_PUBLIC_BOOKING_ENGINE_URL=

# WhatsApp in international digits, e.g. 573001234567. Empty = CTA visible but disabled.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Reception / landline if different from WhatsApp. Digits only.
NEXT_PUBLIC_PHONE=

# Public contact email.
NEXT_PUBLIC_EMAIL=

# Exact street address. Empty = only Buritaca, Magdalena, Colombia is shown.
NEXT_PUBLIC_STREET_ADDRESS=

# Optional postal code.
NEXT_PUBLIC_POSTAL_CODE=

# Coordinates of the property. Both must be set to publish a map pin.
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Optional official Google Maps / Place URL. Overrides the coordinate search.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Official social profiles. Empty URLs are omitted from the site.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# GA4 measurement ID, e.g. G-XXXXXXXX. Empty = no analytics script.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only webhook for the contact form. Never expose this to the client.
CONTACT_WEBHOOK_URL=
